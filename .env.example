# Copy to .env (git-ignored). Read by the sidecar at startup; real env vars win.
# Default backend: your Claude Code login (claude.ai subscription, no API key).
# Sign in once with `claude auth login`.
AUGUSTE_BACKEND=claude-code
# Model alias for Claude Code (sonnet, opus, haiku). Empty = your account default.
AUGUSTE_MODEL=
# Path to the claude binary. Empty = PATH, then ~/.local/bin, ~/.claude/local,
# /opt/homebrew/bin, /usr/local/bin (Houdini doesn't get your shell PATH).
# AUGUSTE_CLAUDE=/Users/you/.local/bin/claude
# Local models instead (pip install -e '.[local]'):
# AUGUSTE_BACKEND=litellm
# AUGUSTE_MODEL=ollama/qwen3
